# Dock: opens or raises the browser, the terminal and the file manager.
# Its strut keeps maximized windows above it, so it never covers a window.

# 1: dock plate
rounded = 14
border_width = 1
border_sides = TBLR
background_color = #ffffff 18
border_color = #ffffff 30

# 2: app button
rounded = 9
border_width = 0
background_color = #ffffff 0
border_color = #ffffff 0
background_color_hover = #ffffff 20
border_color_hover = #ffffff 0
background_color_pressed = #ffffff 32
border_color_pressed = #ffffff 0

panel_items = PPP
panel_size = 140 52
panel_margin = 0 4
panel_padding = 6 6 6
panel_background_id = 1
panel_position = bottom center horizontal
panel_layer = top
panel_dock = 0
autohide = 0
strut_policy = follow_size
panel_window_name = rakazo-dock
wm_menu = 0
mouse_effects = 1
mouse_hover_icon_asb = 100 0 10
mouse_pressed_icon_asb = 100 0 -10
font_shadow = 0
tooltip_show_timeout = 0.4
tooltip_hide_timeout = 0.1

# BROWSER is the display's own launcher on Team desktops.
button = new
button_icon = /usr/share/icons/hicolor/256x256/apps/chromium.png
button_max_icon_size = 40
button_padding = 0 0 0
button_background_id = 2
button_tooltip = Browser
button_lclick_command = wmctrl -x -a chromium || exec "${BROWSER:-rakazo-browser}"

button = new
button_icon = /usr/share/rakazo/desktop/terminal-icon.svg
button_max_icon_size = 40
button_padding = 0 0 0
button_background_id = 2
button_tooltip = Terminal
button_lclick_command = wmctrl -x -a xterm || exec xterm -bg rgb:11/11/13 -fg rgb:e8/e8/ea -cr rgb:e8/e8/ea -title Terminal -xrm 'XTerm*selectToClipboard: true'

button = new
button_icon = /usr/share/rakazo/desktop/files-icon.svg
button_max_icon_size = 40
button_padding = 0 0 0
button_background_id = 2
button_tooltip = Files
button_lclick_command = wmctrl -x -a thunar || exec thunar "$HOME"
