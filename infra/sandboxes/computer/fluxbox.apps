[app] (class=Chromium)
  [Maximized] {yes}
[end]
[app] (class=chromium)
  [Maximized] {yes}
[end]
[app] (class=Google-chrome)
  [Maximized] {yes}
[end]
[app] (class=Firefox)
  [Maximized] {yes}
[end]
[app] (class=XTerm)
  [Maximized] {no}
[end]
[startup] {tint2 -c /etc/rakazo/tint2/menubar.tint2rc}
[startup] {tint2 -c /etc/rakazo/tint2/dock.tint2rc}
